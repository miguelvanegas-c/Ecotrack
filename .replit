modules = ["python-3.11"]
run = "streamlit run app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true"

[deployment]
build = ["sh", "-c", "pip install -r requirements.txt"]
run = ["sh", "-c", "streamlit run app.py --server.port 8080 --server.address 0.0.0.0 --server.headless true --server.enableCORS false --server.enableXsrfProtection false"]

[[ports]]
localPort = 8080
externalPort = 80